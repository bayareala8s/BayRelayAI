# BayRelay customer demo credentials (gitignored — copy from demo.env.example)
# Used by: ./scripts/bayrelay_demo.sh start|smoke|cycle

AWS_REGION=us-west-2

# Create Cognito operator on start (recommended)
CREATE_DEMO_USER=1
COGNITO_DEMO_USERNAME=demo@yourcompany.com
COGNITO_DEMO_EMAIL=demo@yourcompany.com
COGNITO_DEMO_PASSWORD=ChangeMe!Demo1234
COGNITO_DEMO_PERMANENT=1
# operator (default) or partner — partners need COGNITO_DEMO_PARTNER_ID
COGNITO_DEMO_ROLE=operator

# Used by run_full_demo.sh / bayrelay_demo.sh smoke
COGNITO_USERNAME=demo@yourcompany.com
COGNITO_PASSWORD=ChangeMe!Demo1234

# Phase 3 bootstrap on start (default on in demo_start.sh)
BOOTSTRAP_PHASE3=1
SYNC_KB_DOCS=1

# Run smoke automatically after start: RUN_SMOKE=1 ./scripts/bayrelay_demo.sh start --yes
